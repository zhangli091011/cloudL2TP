# 云端软路由控制面板 - 环境变量配置

# 服务端口
API_PORT=3001
WEB_PORT=3000

# JWT 密钥 (生产环境请更换为随机字符串)
JWT_SECRET=change-me-to-a-random-secret-string-at-least-32-chars

# 默认管理员密码 (首次启动时创建)
ADMIN_PASSWORD=admin123

# Mihomo External Controller 配置
# 非 Docker 部署使用 http://127.0.0.1:9090
# Docker 部署在 Linux 上使用 http://172.17.0.1:9090（docker0 网桥网关）
# Docker 部署在 macOS/Windows 上使用 http://host.docker.internal:9090
MIHOMO_API_URL=http://127.0.0.1:9090
MIHOMO_API_SECRET=

# Mihomo 配置文件路径 (宿主机路径)
MIHOMO_CONFIG_DIR=/etc/mihomo
MIHOMO_CONFIG_BACKUP_DIR=/etc/mihomo/backups

# 订阅自动更新间隔 (秒, 默认 3600 = 1小时)
SUBSCRIPTION_UPDATE_INTERVAL=3600

# Mock 模式: 如果为 true，不依赖真实 mihomo，使用模拟数据
MOCK_MODE=false

# 数据库文件路径
DATABASE_PATH=./data/panel.db

# 日志级别: debug | info | warn | error
LOG_LEVEL=info

# VPN 相关 (仅用于 README 说明，程序不自动修改)
# VPN_TYPE=l2tp
# VPN_SERVER_IP=你的云服务器公网IP
# VPN_PSK=你的IPsec预共享密钥
# VPN_USERNAME=vpnuser
# VPN_PASSWORD=你的VPN密码
